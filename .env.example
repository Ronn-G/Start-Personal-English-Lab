GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Optional. Development defaults to .data; portable launcher uses Local AppData.
# PERSONAL_ENGLISH_LAB_DATA_DIR=C:\path\to\writable\data

# Kokoro development server. Copy these placeholders to .env.local.
# KOKORO_PYTHON_PATH=D:\path\to\python.exe
# KOKORO_MODEL_PATH=D:\path\to\kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=D:\path\to\voices-v1.0.bin
# Loopback only. LAN/public hosts are rejected.
# KOKORO_HOST=127.0.0.1
# KOKORO_PORT=5050
# KOKORO_BASE_URL=http://127.0.0.1:5050

# Portable build source containing python.exe.
# PORTABLE_PYTHON_SOURCE=D:\PortableRuntime\Python
