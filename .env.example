GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Optional. Development defaults to .data; portable launcher uses Local AppData.
# PERSONAL_ENGLISH_LAB_DATA_DIR=C:\path\to\writable\data

# Kokoro development server. Set KOKORO_TOOL_DIR, or set all three file paths.
# KOKORO_TOOL_DIR=D:\Kokoro
# KOKORO_PYTHON_PATH=D:\PythonEnvs\kokoro\Scripts\python.exe
# KOKORO_MODEL_PATH=D:\Kokoro\models\kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=D:\Kokoro\models\voices-v1.0.bin

# Portable build source containing python.exe.
# PORTABLE_PYTHON_SOURCE=D:\PortableRuntime\Python
